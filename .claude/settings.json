{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/test-runner.mjs:*)",
      "Bash(npm ci)",
      "Bash(npm ci --silent)",
      "Bash(PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci:*)",
      "Bash(npm --prefix frontend ci:*)",
      "Bash(npm --prefix backend ci:*)",
      "Bash(npm --prefix e2e ci:*)",
      "Bash(npx vite build:*)",
      "Bash(pkill -INT -f e2e/demo.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge-tree:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(node --test backend/tests/*)",
      "Bash(node --test frontend/tests/*)",
      "Bash(git worktree add:*)",
      "Bash(git push -u origin design/:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin docs/:*)",
      "Bash(/usr/lib/postgresql/16/bin/initdb:*)",
      "Bash(/usr/lib/postgresql/16/bin/pg_ctl:*)",
      "Bash(pg_ctlcluster 16 main start)",
      "Bash(pg_ctlcluster 16 main status)",
      "Bash(pg_isready:*)",
      "mcp__claude-code-remote__send_message"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Read(**/.pgpass)",
      "Read(**/pgpass.conf)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.git-credentials)",
      "Read(**/.credentials.json)"
    ],
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
