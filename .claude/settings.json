{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/safety-guard.mjs"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/test-runner.mjs:*)",
      "Bash(npm ci)",
      "Bash(npm ci --silent)",
      "Bash(PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci:*)",
      "Bash(npm --prefix frontend ci:*)",
      "Bash(npm --prefix backend ci:*)",
      "Bash(npm --prefix e2e ci:*)",
      "Bash(npx vite build:*)",
      "Bash(pkill -INT -f e2e/demo.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git push -u origin design/:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin docs/:*)",
      "Bash(/usr/lib/postgresql/16/bin/initdb:*)",
      "Bash(/usr/lib/postgresql/16/bin/pg_ctl:*)",
      "Bash(pg_ctlcluster 16 main start)",
      "Bash(pg_ctlcluster 16 main status)",
      "Bash(pg_isready:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
