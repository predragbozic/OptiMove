# Scoped narrowly to the migration-runner v3.2 PR's own new files, so this
# doesn't touch the line-ending status of any pre-existing tracked file
# (core.autocrlf=true is set locally; a repo-wide rule here would risk
# normalization churn across unrelated files).
migrations_v2/** text eol=lf
backend/src/migrate.js text eol=lf
backend/tests/migration-runner-*.test.mjs text eol=lf
# Test-infrastructure foundation (T1): the runner, its reporter and self-test,
# and the shared test support of both packages - new files only, same reason.
scripts/test-runner*.mjs text eol=lf
backend/tests/support/** text eol=lf
frontend/tests/support/** text eol=lf
