DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Public origin used to build links sent outside the app (athlete invites,
# group join links, email verification). Falls back to the request's own
# host/protocol if unset - only needs to be set explicitly when that
# fallback would be wrong (e.g. behind certain proxy setups).
PUBLIC_APP_URL=https://your-deployed-app.example.com

# Central email service (see backend/src/email.js) - required in production
# (the app refuses to start otherwise - see assertEmailConfigValid); defaults
# to a safe no-op "dev" adapter (logs instead of sending) everywhere else if
# left unset. Supported values: "gmail" (current default production
# provider, via Nodemailer), "resend" (kept as a future option), "dev" /
# "console" (never a real send - not allowed when NODE_ENV=production).
EMAIL_PROVIDER=gmail
EMAIL_FROM=OptiMove <optimovee@gmail.com>
EMAIL_REPLY_TO=optimovee@gmail.com

# Required when EMAIL_PROVIDER=gmail. GMAIL_APP_PASSWORD MUST be a Gmail App
# Password (Google Account -> Security -> App passwords) - never the
# account's normal login password. Read only from this environment
# variable; never logged, never hardcoded anywhere in the codebase.
GMAIL_USER=optimovee@gmail.com
GMAIL_APP_PASSWORD=

# Only required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
