{
  "name": "optimove-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/migrate.js && node src/server.js",
    "migrate": "node src/migrate.js",
    "media:cleanup": "node src/mediaUploadCleanupCli.js",
    "tests:notifications:worker": "node src/testsNotificationWorkerCli.js",
    "training-load:notifications:worker": "node src/trainingLoadNotificationWorkerCli.js",
    "gpexe:retention": "node src/gpexeRetentionCli.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.mjs",
    "test:verify-isolation": "node scripts/verify-test-suite-isolation.mjs",
    "import:plans:preview": "python ../tools/plan_import.py preview",
    "import:plans:apply": "python ../tools/plan_import.py apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mediainfo.js": "^0.3.8",
    "nodemailer": "^9.0.4",
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  }
}
